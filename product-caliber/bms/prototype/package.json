{
  "name": "bms-billing-cost-center-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --outDir .tmp-build --emptyOutDir",
    "build:release": "vite build --outDir dist --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0 --outDir .tmp-build",
    "preview:release": "vite preview --host 0.0.0.0 --outDir dist",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "element-plus": "^2.13.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
