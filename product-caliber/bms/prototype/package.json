{
  "name": "bms-billing-cost-center-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --outDir .tmp-build --emptyOutDir",
    "build:release": "vite build --outDir dist --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0 --outDir .tmp-build",
    "preview:release": "vite preview --host 0.0.0.0 --outDir dist",
    "audit:architecture": "node scripts/architecture-audit.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:headed": "node scripts/run-e2e.mjs --headed",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "check": "vue-tsc --noEmit",
    "verify": "node scripts/architecture-audit.mjs && vue-tsc --noEmit && vitest run && vite build --outDir .tmp-build --emptyOutDir",
    "verify:full": "npm run verify && node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "element-plus": "^2.13.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.26"
  }
}
